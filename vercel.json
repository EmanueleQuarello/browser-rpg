{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npx --yes npm@10.9.4 ci --include=dev",
  "buildCommand": "node node_modules/vite/bin/vite.js build --config apps/web/vite.config.ts",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "rewrites": [
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
