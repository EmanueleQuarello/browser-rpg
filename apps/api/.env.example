# After the Postgres switch, local and Render both use Neon.
# Copy the URI from Neon Dashboard → Connect. Do not commit this file as .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
JWT_SECRET="change-me-in-production"
PORT=3001
HOST=0.0.0.0
